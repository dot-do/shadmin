{
  "name": "shadmin-monorepo",
  "version": "0.0.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:storybook": "storybook build -o storybook-static",
    "dev": "pnpm -r --parallel dev",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:debug": "playwright test --debug",
    "test:e2e": "playwright test",
    "test:e2e:cypress": "cypress run --config-file packages/shadmin/cypress.config.js",
    "test:e2e:cypress:open": "cypress open --config-file packages/shadmin/cypress.config.js",
    "test:e2e:ra-compat": "cypress run --config-file vendor/react-admin/cypress/cypress.config.js",
    "test:e2e:ra-compat:open": "cypress open --config-file vendor/react-admin/cypress/cypress.config.js",
    "dev:ra-compat": "pnpm --filter @shadmin/example-ra-compat dev",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "pnpm -r typecheck",
    "storybook": "storybook dev -p 6006",
    "chromatic": "chromatic --exit-zero-on-changes",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "storybook:audit": "tsx scripts/audit-storybook-coverage.ts",
    "audit:imports": "tsx scripts/audit-imports.ts",
    "bench": "vitest bench --run --config vitest.config.ts",
    "bench:watch": "vitest bench --config vitest.config.ts"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.4",
    "@playwright/test": "^1.49.1",
    "@storybook/addon-a11y": "^8.4.7",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-interactions": "^8.4.7",
    "@storybook/addon-onboarding": "^8.4.7",
    "@storybook/addon-themes": "^8.4.7",
    "@storybook/blocks": "^8.4.7",
    "@storybook/manager-api": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@storybook/test": "^8.4.7",
    "@storybook/theming": "^8.4.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "chromatic": "^11.20.2",
    "cypress": "^13.17.0",
    "cypress-vite": "^1.5.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-storybook": "^0.11.1",
    "glob": "^13.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.70.0",
    "storybook": "^8.4.7",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.16",
    "lodash-es": "^4.17.22",
    "react-router": "^7.12.0",
    "zod": "^4.3.5"
  }
}
