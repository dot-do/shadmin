{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["./src/index.ts"],
  "out": "./docs/api",
  "plugin": ["typedoc-plugin-markdown"],
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "exclude": [
    "**/*.spec.*",
    "**/*.test.*",
    "**/test-utils/**",
    "**/cli/**"
  ],
  "categorizeByGroup": true,
  "categoryOrder": [
    "Components",
    "Hooks",
    "Contexts",
    "Types",
    "Utilities",
    "*"
  ],
  "readme": "none",
  "name": "Shadmin API Reference",
  "hideGenerator": true,
  "sort": ["source-order"],
  "kindSortOrder": [
    "Function",
    "Class",
    "Interface",
    "TypeAlias",
    "Variable"
  ],
  "groupOrder": [
    "Components",
    "Hooks",
    "Contexts",
    "Types",
    "Utilities",
    "*"
  ],
  "navigation": {
    "includeCategories": true,
    "includeGroups": true
  },
  "outputFileStrategy": "modules",
  "entryFileName": "index",
  "skipErrorChecking": true,
  "tsconfig": "./tsconfig.json"
}
