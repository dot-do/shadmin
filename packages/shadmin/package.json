    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "clsx": "^2.1.1",
    "eslint": "^9.17.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "react",
    "admin",
    "ui",
    "shadcn",
    "components",
    "cli",
    "vite"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nathanclevenger/shadmin.git",
    "directory": "packages/shadmin"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-table": "^8.21.3",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "ink": "^6.6.0",
    "ink-select-input": "^6.2.0",
    "lodash-es": "^4.17.22",
    "ra-core": "^5.13.5",
    "react-hook-form": "^7.70.0",
    "react-router": "^7.11.0",
    "react-router-dom": "^7.11.0",
    "vite": "^6.0.5",
    "zod": "^4.3.5"
  }
}
