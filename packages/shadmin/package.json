  "files": [
    "dist",
    "src/cli",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:light": "vitest run --no-file-parallelism --pool=forks --poolOptions.forks.maxForks=2",
    "test:single": "vitest run --no-file-parallelism --pool=forks --poolOptions.forks.maxForks=1",
    "format": "prettier --write src"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@mdxui/admin": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@mdxui/admin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
