        "types": "./dist/components/layout/index.d.ts",
        "default": "./dist/components/layout.cjs"
      }
    },
    "./components/edit": {
      "import": {
        "types": "./dist/components/edit/index.d.ts",
        "default": "./dist/components/edit.js"
      },
      "require": {
        "types": "./dist/components/edit/index.d.ts",
